# speaker-service environment template. Copy to `.env` and adjust as needed.
# NEVER put real secrets in this file; the service token lives in the macOS
# Keychain (service `voicestack-service`, account `service`).

# TCP port the service listens on (VoiceStudio uses 3900; do not collide).
VASTACK_PORT=3910

# Bind address. Loopback only by default; never a wildcard bind address.
VASTACK_BIND=127.0.0.1

# Idle seconds before the on-demand service exits.
VASTACK_IDLE_EXIT_S=600

# Optional bearer-token override. Leave empty to read from the Keychain.
VASTACK_TOKEN=

# Delete the uploaded meeting audio once its transcription job completes.
# Default off. When on, a cluster's voiceprint cannot be computed after the
# job finishes (the audio is gone); enroll before enabling.
VASTACK_DELETE_AUDIO_AFTER_TRANSCRIBE=false
